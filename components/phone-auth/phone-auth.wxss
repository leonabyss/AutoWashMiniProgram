.auth-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(15, 23, 42, 0.58);
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.72;
}

.auth-dialog {
  width: 100%;
  max-width: 640rpx;
  padding: 52rpx 40rpx 34rpx;
  border-radius: 20rpx;
  text-align: center;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(15, 23, 42, 0.22);
}

.auth-icon {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
}

.auth-icon-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #e8f1ff;
}

.auth-icon-phone {
  position: absolute;
  left: 37rpx;
  top: 22rpx;
  width: 38rpx;
  height: 68rpx;
  border: 6rpx solid #216fe9;
  border-radius: 12rpx;
  background: #fff;
}

.auth-title {
  color: #13223a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.auth-desc {
  margin-top: 18rpx;
  color: #66758c;
  font-size: 28rpx;
  line-height: 1.55;
}

button.auth-primary {
  width: 100%;
  height: 92rpx;
  margin-top: 40rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 92rpx;
  background: #216fe9;
}

button.auth-cancel {
  width: 100%;
  height: 80rpx;
  margin-top: 12rpx;
  color: #7a879c;
  font-size: 28rpx;
  line-height: 80rpx;
  background: transparent;
}
