<view class="scan-page {{reviewMode ? 'review-scan-mode' : ''}}">
  <include src="../../components/review-notice/review-notice.wxml" />
  <view wx:if="{{!canScan && !phoneAuthVisible}}" class="scan-loading">
    <view class="loading-spinner"></view>
    <text>{{reviewMode ? '正在识别模拟洗车设备…' : '正在检查登录状态…'}}</text>
  </view>

  <block wx:if="{{canScan}}">
    <view class="scan-toolbar">
      <view class="scan-heading">
        <view class="heading-icon-wrap">
          <image class="heading-icon" src="/assets/icons/lucide-qr-code.svg" mode="aspectFit"></image>
        </view>
        <view class="heading-copy">
          <text class="heading-title">扫描洗车机二维码</text>
          <text class="heading-subtitle">对准设备上的二维码即可识别</text>
        </view>
      </view>

    </view>

    <camera
      class="scan-camera"
      style="top: {{cameraTop}}px; height: {{cameraHeight}}px;"
      mode="scanCode"
      device-position="back"
      flash="{{flashMode}}"
      bindinitdone="onCameraInit"
      binderror="onCameraError"
      bindscancode="onScanCode"
    ></camera>

    <cover-view class="scan-mask top-mask" style="top: {{cameraTop}}px; height: {{maskTopHeight}}px;"></cover-view>
    <cover-view class="scan-mask left-mask" style="top: {{frameTop}}px; width: {{frameLeft}}px; height: {{scanSize}}px;"></cover-view>
    <cover-view class="scan-mask right-mask" style="top: {{frameTop}}px; width: {{frameLeft}}px; height: {{scanSize}}px;"></cover-view>
    <cover-view class="scan-mask bottom-mask" style="top: {{frameBottom}}px; bottom: {{actionHeight}}px;"></cover-view>

    <cover-view
      class="scan-frame"
      style="left: {{frameLeft}}px; top: {{frameTop}}px; width: {{scanSize}}px; height: {{scanSize}}px;"
    >
      <cover-view class="frame-edge frame-edge-top"></cover-view>
      <cover-view class="frame-edge frame-edge-right"></cover-view>
      <cover-view class="frame-edge frame-edge-bottom"></cover-view>
      <cover-view class="frame-edge frame-edge-left"></cover-view>
      <cover-view class="corner left-top"><cover-view class="corner-horizontal"></cover-view><cover-view class="corner-vertical"></cover-view></cover-view>
      <cover-view class="corner right-top"><cover-view class="corner-horizontal"></cover-view><cover-view class="corner-vertical"></cover-view></cover-view>
      <cover-view class="corner left-bottom"><cover-view class="corner-horizontal"></cover-view><cover-view class="corner-vertical"></cover-view></cover-view>
      <cover-view class="corner right-bottom"><cover-view class="corner-horizontal"></cover-view><cover-view class="corner-vertical"></cover-view></cover-view>
      <cover-view class="alignment-mark alignment-top"></cover-view>
      <cover-view class="alignment-mark alignment-right"></cover-view>
      <cover-view class="alignment-mark alignment-bottom"></cover-view>
      <cover-view class="alignment-mark alignment-left"></cover-view>
      <cover-view class="scan-line" style="top: {{scanLineTop}}px;"></cover-view>
    </cover-view>

    <cover-view class="recognition-status status-{{scanStatusTone}}" style="top: {{tipTop}}px;">
      <cover-view class="status-dot"></cover-view>
      <cover-view class="status-text">{{scanStatusText}}</cover-view>
    </cover-view>

    <cover-view wx:if="{{errorText}}" class="scan-error">
      <cover-view>{{errorText}}</cover-view>
    </cover-view>

    <cover-view class="scan-helper" style="{{reviewMode ? 'bottom:' + (actionHeight + 10) + 'px;' : ''}}">{{reviewMode ? '无需真实二维码，点击下方按钮体验' : '保持手机稳定，识别成功后将自动跳转'}}</cover-view>

    <view class="scan-actions" style="height: {{actionHeight}}px;">
      <button wx:if="{{reviewMode}}" class="review-scan-button" bindtap="scanReviewDevice" loading="{{resolving}}" disabled="{{resolving}}">{{resolving ? '正在识别模拟设备' : '审核体验：识别模拟设备'}}</button>
      <view class="scan-action-tools">
      <button class="scan-action {{torchOn ? 'is-active' : ''}}" bindtap="toggleTorch">
        <view class="action-icon-wrap">
          <image class="action-icon" src="/assets/icons/lucide-flashlight.png" mode="aspectFit"></image>
        </view>
        <text class="action-text">{{torchOn ? '关闭手电' : '打开手电'}}</text>
      </button>
      <view class="action-divider"></view>
      <button class="scan-action" bindtap="scanFromAlbum">
        <view class="action-icon-wrap">
          <image class="action-icon" src="/assets/icons/lucide-images.png" mode="aspectFit"></image>
        </view>
        <text class="action-text">从相册选择</text>
      </button>
      </view>
    </view>
  </block>

  <phone-auth
    visible="{{phoneAuthVisible}}"
    title="微信手机号登录"
    desc="扫码洗车前需要授权手机号，用于识别会员、余额和当前订单。"
    bindsuccess="onPhoneAuthSuccess"
    bindcancel="onPhoneAuthCancel"
  />
</view>
