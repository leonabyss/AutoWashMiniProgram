page {
  background: #ffffff;
}

.ready-page {
  display: flex;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  flex-direction: column;
  overflow: hidden;
  color: #15233d;
  background: #ffffff;
}

.progress-strip {
  position: relative;
  display: flex;
  flex: 0 0 112rpx;
  padding: 18rpx 26rpx 12rpx;
  align-items: flex-start;
  justify-content: space-between;
  background: #ffffff;
}

.progress-line {
  position: absolute;
  left: 92rpx;
  right: 92rpx;
  top: 42rpx;
  height: 3rpx;
  background: #d8dde7;
}

.progress-line::before {
  position: absolute;
  left: 0;
  top: 0;
  width: 67%;
  height: 100%;
  content: '';
  background: #1262e8;
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  width: 150rpx;
  align-items: center;
  flex-direction: column;
  color: #7b8496;
}

.progress-dot {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #d4d9e2;
  border-radius: 50%;
  background: #ffffff;
}

.progress-dot image {
  width: 30rpx;
  height: 30rpx;
}

.progress-step.completed .progress-dot {
  border-color: #1262e8;
  background: #1262e8;
}

.progress-step.active .progress-dot {
  border-color: #1262e8;
}

.progress-core {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #1262e8;
}

.progress-step text {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.progress-step.completed,
.progress-step.active {
  color: #1262e8;
}

.status-strip {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 23rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf4;
}

.status-pulse {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #1262e8;
  box-shadow: 0 0 0 8rpx rgba(18, 98, 232, 0.1);
  animation: status-pulse 1.5s ease-in-out infinite;
}

@keyframes status-pulse {
  0%, 100% { opacity: 0.5; transform: scale(0.82); }
  50% { opacity: 1; transform: scale(1); }
}

.gun-stage {
  display: flex;
  flex: 0 1 44vh;
  min-height: 390rpx;
  max-height: 590rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #eff7ff;
}

.gun-panel-image {
  width: 100%;
  height: 100%;
}

.ready-content {
  flex: 1;
  min-height: 292rpx;
  padding: 22rpx 42rpx 8rpx;
  overflow: hidden;
  background: #ffffff;
}

.ready-heading {
  color: #10213f;
  font-size: 37rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.ready-subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.instruction-list {
  margin-top: 16rpx;
}

.instruction-row {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  border-bottom: 1rpx solid #e4e9f1;
}

.instruction-row:last-child {
  border-bottom: 0;
}

.instruction-icon {
  display: flex;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.instruction-icon image {
  width: 34rpx;
  height: 34rpx;
}

.water-icon-wrap {
  background: #e9f1ff;
}

.stop-icon-wrap {
  background: #ffebec;
}

.instruction-copy {
  margin-left: 18rpx;
  color: #475467;
  font-size: 25rpx;
  line-height: 1.35;
}

.instruction-label {
  font-weight: 700;
}

.water-label {
  color: #1262e8;
}

.stop-label {
  color: #e92c35;
}

.ready-footer {
  flex: 0 0 auto;
  padding: 12rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.remote-control-btn {
  display: flex;
  width: 100% !important;
  max-width: none !important;
  height: 128rpx;
  margin: 0 !important;
  padding: 0 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #ffffff;
  text-align: left;
  background: #09ac55;
  box-shadow: 0 12rpx 24rpx rgba(9, 172, 85, 0.22);
}

.remote-control-btn[disabled] {
  color: rgba(255, 255, 255, 0.78);
  background: #75c99d;
}

.remote-control-hover {
  background: #079a4c;
}

.remote-control-icon {
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  margin-right: 26rpx;
}

.remote-control-copy {
  display: flex;
  flex-direction: column;
}

.remote-control-title {
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.15;
}

.remote-control-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  line-height: 1.15;
}

@media screen and (max-height: 680px) {
  .progress-strip {
    flex-basis: 94rpx;
    padding-top: 10rpx;
  }

  .progress-line {
    top: 33rpx;
  }

  .progress-dot {
    width: 42rpx;
    height: 42rpx;
  }

  .progress-step text {
    margin-top: 7rpx;
    font-size: 21rpx;
  }

  .status-strip {
    flex-basis: 46rpx;
    font-size: 21rpx;
  }

  .gun-stage {
    flex-basis: 39vh;
    min-height: 330rpx;
  }

  .ready-content {
    min-height: 250rpx;
    padding-top: 14rpx;
  }

  .ready-heading {
    font-size: 32rpx;
  }

  .ready-subtitle {
    margin-top: 6rpx;
    font-size: 21rpx;
  }

  .instruction-list {
    margin-top: 10rpx;
  }

  .instruction-row {
    min-height: 68rpx;
  }

  .instruction-icon {
    flex-basis: 50rpx;
    width: 50rpx;
    height: 50rpx;
  }

  .instruction-copy {
    font-size: 22rpx;
  }

  .remote-control-btn {
    height: 106rpx;
  }

  .remote-control-icon {
    flex-basis: 50rpx;
    width: 50rpx;
    height: 50rpx;
    margin-right: 20rpx;
  }

  .remote-control-title {
    font-size: 31rpx;
  }

  .remote-control-subtitle {
    margin-top: 7rpx;
    font-size: 20rpx;
  }
}

@media screen and (max-width: 350px) {
  .progress-strip {
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .progress-line {
    left: 72rpx;
    right: 72rpx;
  }

  .progress-step {
    width: 132rpx;
  }

  .progress-step text {
    font-size: 20rpx;
  }

  .ready-content {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .remote-control-subtitle {
    font-size: 18rpx;
  }
}
