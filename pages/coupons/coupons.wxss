.coupon-page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; box-sizing: border-box; background: #f5f7fb; }.summary { display: flex; align-items: baseline; padding: 34rpx 36rpx; border-radius: 18rpx; color: #fff; background: #216fe9; }.summary-number { font-size: 60rpx; font-weight: 800; }.summary-label { margin-left: 12rpx; font-size: 27rpx; opacity: .84; }
.coupon-list { margin-top: 24rpx; }.coupon-card { display: flex; align-items: center; min-height: 180rpx; margin-bottom: 20rpx; padding: 26rpx; box-sizing: border-box; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(14,40,80,.06); }.coupon-mark { width: 92rpx; height: 92rpx; flex: 0 0 auto; border-radius: 50%; color: #fff; font-size: 42rpx; font-weight: 800; line-height: 92rpx; text-align: center; background: #216fe9; }.coupon-info { min-width: 0; flex: 1; margin-left: 24rpx; }.coupon-name { color: #17243b; font-size: 31rpx; font-weight: 800; }.coupon-detail { margin-top: 8rpx; color: #55647a; font-size: 25rpx; }.coupon-expire { margin-top: 13rpx; color: #929cad; font-size: 22rpx; }.coupon-status { color: #16a34a; font-size: 24rpx; font-weight: 700; }.coupon-card.used,.coupon-card.expired,.coupon-card.disabled { opacity: .58; }.coupon-card.used .coupon-status,.coupon-card.expired .coupon-status,.coupon-card.disabled .coupon-status { color: #8c96a7; }
.empty { padding: 120rpx 24rpx; color: #8a95a8; font-size: 27rpx; text-align: center; }.retry-btn { width: 200rpx !important; height: 70rpx !important; margin: 28rpx auto 0 !important; border-radius: 35rpx; color: #fff; line-height: 70rpx; text-align: center; background: #216fe9; }
