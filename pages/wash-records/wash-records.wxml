<view class="list-page {{reviewMode ? 'review-flow-mode' : ''}}">
  <include src="../../components/review-notice/review-notice.wxml" />
  <view wx:if="{{reviewMode}}" class="review-account-note">仅显示当前账号在本机已同步的模拟洗车订单。</view>
  <view wx:if="{{reviewStale}}" class="review-account-note">部分记录暂为上次同步数据。</view>
  <view wx:if="{{records.length}}" class="record-list">
    <view wx:for="{{records}}" wx:key="orderNo" class="record-card">
      <view class="record-top">
        <view class="record-title">{{item.siteName}}</view>
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="record-sub">{{item.machineName}} · {{item.payMethodText}}</view>
      <view class="record-meta">
        <view>
          <text class="meta-label">用时</text>
          <text>{{item.durationText}}</text>
        </view>
        <view>
          <text class="meta-label">{{reviewMode && item.statusClass !== 'finished' ? '预计费用' : '消费'}}</text>
          <text class="amount">{{item.amountText}}</text>
        </view>
      </view>
      <view class="record-time">开始：{{item.createdAtText}}</view>
      <view class="record-time">完成：{{item.finishedAtText}}</view>
    </view>
  </view>
  <view wx:elif="{{loadError && !loading}}" class="empty-state">
    <view class="empty-title">记录加载失败</view>
    <view class="empty-desc" bindtap="onPullDownRefresh">点击重新获取</view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-icon">洗</view>
    <view class="empty-title">暂无记录</view>
    <view class="empty-desc">完成洗车后，记录会显示在这里</view>
  </view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
  <view wx:if="{{loadingMore}}" class="bottom-tip">继续加载...</view>
  <view wx:if="{{finished && records.length}}" class="bottom-tip">没有更多了</view>
</view>
