page {
  height: 100%;
  overflow: hidden;
  background: #f5f8fc;
}

.new-home-page {
  --page-gap: 10rpx;
  --section-gap: 10rpx;
  width: 100vw;
  min-height: 0;
  max-height: 100%;
  color: #111b2c;
  overflow: hidden;
  background: #f5f8fc;
}

.new-home-page button {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  line-height: normal;
  background: transparent;
}

.new-home-page button::after {
  display: none;
}

.new-home-content {
  width: 100%;
  height: 100%;
  min-height: 0;
  min-width: 0;
  box-sizing: border-box;
  padding: var(--page-gap);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr) auto;
  gap: var(--section-gap);
}

.account-card {
  flex: 0 0 138rpx;
  height: 138rpx;
  min-height: 0;
  padding: 24rpx 28rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 2rpx minmax(190rpx, 0.84fr);
  align-items: center;
  column-gap: 26rpx;
  border: 2rpx solid #e1e8f2;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(27, 74, 139, 0.08);
}

.account-card.account-overview {
  grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 0.9fr));
  column-gap: 0;
  padding: 18rpx 16rpx;
}

.account-rights {
  min-width: 0;
  height: 82rpx;
  padding: 0 18rpx 0 6rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-right: 2rpx solid #e3e8f0;
}

.account-rights-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-rights-title {
  overflow: hidden;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-rights-detail {
  overflow: hidden;
  color: #7a8494;
  font-size: 18rpx;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-rights-detail.active {
  color: #0865e7;
}

.account-rights-detail.expiring {
  color: #ef6b2e;
}

.account-metric {
  width: 100% !important;
  min-width: 0;
  height: 92rpx;
  padding: 0 8rpx !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-right: 2rpx solid #e3e8f0 !important;
  background: transparent !important;
}

.account-metric:last-child {
  border-right: 0 !important;
}

.metric-label {
  color: #667085;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
}

.metric-value {
  color: #101828;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1;
}

.metric-action {
  color: #0865e7;
  font-size: 17rpx;
  line-height: 1;
  white-space: nowrap;
}

.guest-login-card {
  width: 100% !important;
  flex: 0 0 138rpx;
  height: 138rpx;
  min-height: 0;
  padding: 22rpx 28rpx !important;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid #e1e8f2 !important;
  border-radius: 8rpx !important;
  text-align: left;
  background: #ffffff !important;
  box-shadow: 0 10rpx 26rpx rgba(27, 74, 139, 0.08);
}

.guest-login-icon-wrap {
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf4ff;
}

.guest-login-icon {
  width: 40rpx;
  height: 40rpx;
}

.guest-login-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guest-login-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.15;
}

.guest-login-desc {
  overflow: hidden;
  color: #778295;
  font-size: 21rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-login-action {
  flex: 0 0 auto;
  color: #0865e7;
  font-size: 24rpx;
  font-weight: 650;
}

.membership-state {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.membership-crown {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
}

.membership-label {
  min-width: 0;
  color: #1d2738;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.account-divider {
  width: 2rpx;
  height: 66rpx;
  background: #e3e8f0;
}

.account-summary {
  min-width: 0;
}

.account-prefix {
  display: block;
  margin-bottom: 6rpx;
  color: #5e697b;
  font-size: 22rpx;
  line-height: 1.2;
}

.account-value-line {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.account-value {
  min-width: 0;
  color: #0b172b;
  font-size: 54rpx;
  font-weight: 750;
  line-height: 1;
}

.account-unit {
  flex: 0 0 auto;
  color: #263246;
  font-size: 24rpx;
  line-height: 1;
}

.account-summary.guest .account-value,
.account-summary.duration .account-value {
  font-size: 32rpx;
  line-height: 1.2;
}

.account-summary.coupon .account-value,
.account-summary.vip .account-value {
  font-size: 46rpx;
}

.banner-section {
  position: relative;
  min-height: 0;
  height: 100%;
  max-height: 100%;
  align-self: stretch;
  overflow: visible;
}

.banner-swiper,
.banner-item {
  width: 100%;
  height: 100%;
}

.banner-swiper {
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8f1ff;
}

.banner-item {
  position: relative;
  overflow: hidden;
}

.banner-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.banner-loading {
  width: 100%;
  height: 100%;
  background: #e8f1ff;
}

.banner-dots {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  z-index: 5;
  height: 30rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.88);
  transform: translateX(-50%);
}

.banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c5cad2;
  transition: width 180ms ease, background-color 180ms ease;
}

.banner-dot.active {
  width: 26rpx;
  border-radius: 6rpx;
  background: #0f63df;
}

.badge-stack {
  position: absolute;
  top: 20rpx;
  right: calc(0rpx - var(--page-gap));
  z-index: 6;
  width: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.cms-edge-entry {
  width: 100%;
  overflow: hidden;
  border-radius: 8rpx 0 0 8rpx;
  box-shadow: -6rpx 8rpx 18rpx rgba(13, 65, 139, 0.16);
}

.cms-edge-image {
  display: block;
  width: 100%;
  height: auto;
}

.join-edge-entry {
  position: absolute;
  top: 20rpx;
  right: calc(0rpx - var(--page-gap));
  z-index: 6;
  width: 194rpx;
  height: 70rpx;
  padding: 0 20rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 8rpx 0 0 8rpx !important;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 650;
  background: #075ed9 !important;
  box-shadow: -6rpx 8rpx 18rpx rgba(13, 65, 139, 0.18);
}

.join-edge-icon {
  width: 34rpx;
  height: 34rpx;
}

.operation-area {
  width: 100%;
  min-width: 0;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--section-gap);
}

.scan-action {
  --scan-content-height: 64rpx;
  width: 100% !important;
  min-width: 100% !important;
  align-self: stretch;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  border-radius: 8rpx !important;
  color: #ffffff !important;
  font-size: 54rpx;
  font-weight: 750;
  background: #0865e7 !important;
  box-shadow: 0 14rpx 28rpx rgba(8, 101, 231, 0.22);
}

.scan-action.resume-mode {
  background: #11934b !important;
  box-shadow: 0 14rpx 28rpx rgba(17, 147, 75, 0.22);
}

.scan-action.order-actions {
  position: relative;
  display: flex;
  padding: 0 !important;
  gap: 0;
  overflow: hidden;
  isolation: isolate;
  box-shadow: 0 12rpx 24rpx rgba(28, 69, 65, 0.16);
}

.new-home-page .order-half {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: 50% !important;
  min-width: 0 !important;
  height: 100%;
  margin: 0 !important;
  padding: 0 8rpx !important;
  border-radius: 0 !important;
  color: #ffffff !important;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.new-home-page .order-continue { background: #11934b !important; }
.new-home-page .order-finish { background: #dc5435 !important; }

.order-bubble {
  position: absolute;
  z-index: 2;
  top: 50%;
  width: 220%;
  padding-bottom: 220%;
  border-radius: 50%;
  pointer-events: none;
  animation: order-bubble-expand 480ms cubic-bezier(0.22, 0.7, 0.2, 1) forwards;
}

.bubble-continue { left: 25%; background: #11934b; }
.bubble-finish { left: 75%; background: #dc5435; }

.order-action-label {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 38rpx;
  pointer-events: none;
  animation: order-label-show 480ms ease both;
}

@keyframes order-bubble-expand {
  from { transform: translate(-50%, -50%) scale(0); }
  to { transform: translate(-50%, -50%) scale(1); }
}

@keyframes order-label-show {
  0%, 35% { opacity: 0; }
  100% { opacity: 1; }
}

.scan-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
}

.scan-action-label {
  display: flex;
  height: var(--scan-content-height);
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  line-height: 1;
  white-space: nowrap;
}

.scan-icon {
  display: block;
  width: 64rpx;
  height: 64rpx;
}

.scan-beam {
  position: absolute;
  left: 2rpx;
  top: 8rpx;
  z-index: 2;
  width: 60rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.8);
  animation: scan-beam-move 1.6s ease-in-out infinite alternate;
}

@keyframes scan-beam-move {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(44rpx);
  }
}

.secondary-actions {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--page-gap);
}

.secondary-action-wrap {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.card-action-wrap {
  position: relative;
  min-width: 0;
}

.new-home-page .secondary-action {
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  margin: 0 !important;
  box-sizing: border-box;
  height: 104rpx;
  padding: 0 20rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  border: 2rpx solid #d8e2f0 !important;
  border-radius: 8rpx !important;
  text-align: left;
  background: #ffffff !important;
}

.secondary-icon {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
}

.secondary-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
}

.secondary-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.1;
  white-space: nowrap;
}

.secondary-subtitle {
  color: #7a8494;
  font-size: 22rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.save-badge {
  position: absolute;
  top: -14rpx;
  right: 12rpx;
  z-index: 3;
  max-width: calc(100% - 24rpx);
  height: 36rpx;
  padding: 0 13rpx;
  overflow: hidden;
  border: 2rpx solid #ffcf66;
  border-bottom: 4rpx solid #f29b12;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  color: #694100;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #fff3c9;
  box-shadow: 0 6rpx 12rpx rgba(175, 103, 0, 0.13);
}

.last-use-row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  min-height: 72rpx;
  margin: 0;
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid #e0e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.last-use-icon,
.rescan-icon {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
}

.last-use-content {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.last-use-label {
  flex: 0 0 auto;
  color: #1468dc;
}

.last-use-site {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #242d3b;
  text-overflow: ellipsis;
}

.last-use-machine {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 26%;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #242d3b;
}

.last-use-status {
  flex: 0 0 auto;
  font-weight: 650;
}

.last-use-status.idle {
  color: #119a47;
}

.last-use-status.busy {
  color: #e23a36;
}

.last-use-status.maintenance {
  color: #8b93a0;
}

.rescan-action {
  width: 100%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  color: #1468dc !important;
  font-size: 24rpx;
}

