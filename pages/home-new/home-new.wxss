  .scan-beam {
    animation: none;
    top: 29rpx;
  }

}
.review-entry {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  z-index: 4;
  width: auto !important;
  margin: 0 !important;
  padding: 8rpx 16rpx !important;
  font-size: 22rpx;
  line-height: 1.5;
  color: #1559c5;
  background: #ffffff;
  border: 1rpx solid #c7d8f1;
  border-radius: 8rpx;
}
.review-home-notice { position: absolute; top: 0; left: 0; right: 0; z-index: 4; padding: 8rpx; color: #774b12; background: #fff0ce; font-size: 22rpx; text-align: center; }
