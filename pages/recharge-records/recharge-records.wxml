<view class="list-page">
  <view wx:if="{{records.length}}" class="record-list">
    <view wx:for="{{records}}" wx:key="recordKey" class="record-card">
      <view class="record-top">
        <view class="record-title">{{item.title}}</view>
        <view class="amount {{item.directionClass}}">{{item.amountText}}</view>
      </view>
      <view class="record-sub">
        <text>{{item.bizTypeText}}</text>
        <text wx:if="{{item.statusText}}"> · {{item.statusText}}</text>
      </view>
      <view class="record-footer">
        <text>{{item.createdAtText}}</text>
        <text>{{item.balanceText}}</text>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-icon">充</view>
    <view class="empty-title">暂无记录</view>
    <view class="empty-desc">充值或余额变动后，记录会显示在这里</view>
  </view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
  <view wx:if="{{loadingMore}}" class="bottom-tip">继续加载...</view>
  <view wx:if="{{finished && records.length}}" class="bottom-tip">没有更多了</view>
</view>
