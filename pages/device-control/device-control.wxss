page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
}

.device-control-page {
  display: flex;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  padding: 28rpx 40rpx calc(22rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  overflow: hidden;
  color: #172640;
  background: #ffffff;
}

.control-status {
  display: grid;
  width: 100%;
  height: 108rpx;
  flex: 0 0 108rpx;
  grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 1fr);
  align-items: center;
  border: 1rpx solid #e7ebf2;
  border-radius: 16rpx;
  background: #f7f9fc;
  box-shadow: 0 8rpx 22rpx rgba(22, 44, 84, 0.06);
}

.status-item {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  color: #26344e;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.status-dot {
  width: 15rpx;
  height: 15rpx;
  margin-right: 13rpx;
  flex: 0 0 15rpx;
  border-radius: 50%;
  background: #18c964;
  box-shadow: 0 0 0 7rpx rgba(24, 201, 100, 0.11);
}

.status-icon {
  width: 33rpx;
  height: 33rpx;
  margin-right: 11rpx;
  flex: 0 0 33rpx;
}

.status-divider {
  width: 1rpx;
  height: 54rpx;
  background: #dde3ed;
}

.device-control-list {
  display: grid;
  min-height: 0;
  margin-top: 34rpx;
  flex: 1;
  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) minmax(128rpx, 0.72fr) 90rpx;
  gap: 28rpx;
}

.device-action {
  position: relative;
  display: grid;
  width: 100% !important;
  height: 100% !important;
  min-height: 0;
  margin: 0 !important;
  padding: 0 64rpx !important;
  grid-template-columns: minmax(110rpx, 0.82fr) 1rpx minmax(0, 1.18fr);
  align-items: center;
  border-radius: 16rpx;
  color: #ffffff;
  background: #1262e8;
  box-shadow: 0 14rpx 26rpx rgba(18, 98, 232, 0.18);
  transform: translateY(0) scale(1);
  transition: transform 120ms ease, box-shadow 160ms ease, opacity 160ms ease, background-color 180ms ease;
}

.device-action::after {
  display: none;
}

.water-action {
  background: #1262e8;
}

.foam-action {
  background: #05add1;
  box-shadow: 0 14rpx 26rpx rgba(5, 173, 209, 0.18);
}

.stop-action {
  background: #ff3b43;
  box-shadow: 0 14rpx 26rpx rgba(255, 59, 67, 0.17);
}

.device-action-hover {
  opacity: 0.94;
  transform: translateY(3rpx) scale(0.985);
  box-shadow: 0 6rpx 12rpx rgba(22, 54, 104, 0.16);
}

.device-action[disabled] {
  color: #ffffff;
  opacity: 0.52;
}

.water-action[disabled] {
  background: #1262e8 !important;
}

.foam-action[disabled] {
  background: #05add1 !important;
}

.stop-action[disabled] {
  background: #ff3b43 !important;
}

.device-action.action-running,
.device-action.action-waiting {
  color: #ffffff;
  box-shadow: 0 10rpx 18rpx rgba(28, 43, 65, 0.12);
  opacity: 1;
}

.water-action.action-running {
  background: #0b56c7 !important;
  box-shadow: 0 0 0 5rpx rgba(18, 98, 232, 0.12), 0 14rpx 28rpx rgba(18, 98, 232, 0.22);
}

.foam-action.action-running {
  background: #078dab !important;
  box-shadow: 0 0 0 5rpx rgba(5, 173, 209, 0.12), 0 14rpx 28rpx rgba(5, 173, 209, 0.22);
}

.device-action.action-waiting {
  background: #506986 !important;
}

.device-action.action-sending {
  opacity: 1;
  animation: command-glow 1.1s ease-in-out infinite;
}

.water-action.action-sending {
  background: #0d55c9 !important;
}

.foam-action.action-sending {
  background: #078eab !important;
}

.stop-action.action-sending {
  background: #d92f38 !important;
}

.action-icon-wrap {
  position: relative;
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.device-action-icon {
  position: relative;
  z-index: 2;
  width: 90rpx;
  height: 90rpx;
}

.action-feedback-ring {
  position: absolute;
  z-index: 1;
  width: 98rpx;
  height: 98rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.72);
}

.action-sending .action-feedback-ring {
  animation: command-ring 1.1s ease-out infinite;
}

.action-sending .device-action-icon {
  animation: command-icon 0.7s ease-in-out infinite alternate;
}

.action-running .device-action-icon {
  animation: active-icon-breathe 1.8s ease-in-out infinite;
}

.stop-action-icon {
  width: 84rpx;
  height: 84rpx;
}

.action-divider {
  width: 1rpx;
  height: 108rpx;
  background: rgba(255, 255, 255, 0.42);
}

.stop-action .action-divider {
  height: 76rpx;
}

.device-action-copy {
  display: flex;
  min-width: 0;
  padding-left: 42rpx;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
}

.device-action-title {
  font-size: 58rpx;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.device-action-sub {
  max-width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

@keyframes command-glow {
  0%, 100% {
    box-shadow: 0 10rpx 20rpx rgba(20, 54, 100, 0.17);
  }
  50% {
    box-shadow: 0 16rpx 34rpx rgba(20, 54, 100, 0.3);
  }
}

@keyframes command-ring {
  0% {
    opacity: 0.7;
    transform: scale(0.68);
  }
  80%, 100% {
    opacity: 0;
    transform: scale(1.35);
  }
}

@keyframes command-icon {
  from { transform: scale(0.94); }
  to { transform: scale(1.06); }
}

@keyframes active-icon-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.exit-remote-btn {
  display: flex;
  width: 100% !important;
  height: 90rpx !important;
  min-height: 90rpx;
  margin: 0 !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #1262e8;
  border-radius: 16rpx;
  color: #1262e8;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1;
  background: #ffffff;
}

.exit-remote-btn::after {
  display: none;
}

.exit-remote-hover {
  background: #eef5ff;
}

.exit-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
}

@media screen and (max-height: 700px) {
  .device-control-page {
    padding-top: 18rpx;
    padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  }

  .control-status {
    height: 90rpx;
    flex-basis: 90rpx;
  }

  .device-control-list {
    margin-top: 22rpx;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) minmax(112rpx, 0.68fr) 78rpx;
    gap: 20rpx;
  }

  .device-action {
    padding-right: 52rpx !important;
    padding-left: 52rpx !important;
  }

  .device-action-icon {
    width: 72rpx;
    height: 72rpx;
  }

  .action-divider {
    height: 82rpx;
  }

  .device-action-title {
    font-size: 50rpx;
  }

  .device-action-sub {
    margin-top: 10rpx;
    font-size: 24rpx;
  }

  .exit-remote-btn {
    height: 78rpx !important;
    min-height: 78rpx;
  }
}

@media screen and (max-width: 350px) {
  .device-control-page {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .control-status {
    grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 0.9fr) 1rpx minmax(0, 0.75fr);
  }

  .status-item {
    font-size: 21rpx;
  }

  .status-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 7rpx;
  }

  .status-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 8rpx;
    flex-basis: 12rpx;
  }

  .device-action {
    padding-right: 38rpx !important;
    padding-left: 38rpx !important;
    grid-template-columns: minmax(90rpx, 0.8fr) 1rpx minmax(0, 1.2fr);
  }

  .device-action-copy {
    padding-left: 28rpx;
  }

  .device-action-title {
    font-size: 48rpx;
  }
}
