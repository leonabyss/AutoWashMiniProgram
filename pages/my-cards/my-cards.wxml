<view class="card-page {{reviewMode ? 'review-flow-mode' : ''}}">
  <include src="../../components/review-notice/review-notice.wxml" />
  <view wx:if="{{reviewMode}}" class="review-account-note">体验展示卡为本机模拟购买记录，不发放真实权益。其余为真实持有卡券，模拟洗车不会消耗。</view>
  <view class="tabs">
    <view class="tab-slider slider-{{activeTabIndex}}"></view>
    <button
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-btn {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <view class="tab-content">
        <text class="tab-label">{{item.label}}</text>
        <text wx:if="{{item.key === 'member'}}" class="tab-count">{{memberCards.length}}</text>
        <text wx:if="{{item.key === 'washCard'}}" class="tab-count">{{washCards.length}}</text>
        <text wx:if="{{item.key === 'coupon'}}" class="tab-count">{{coupons.length}}</text>
      </view>
    </button>
  </view>

  <view wx:if="{{currentItems.length}}" class="card-list">
    <view wx:for="{{currentItems}}" wx:key="uniqueId" class="wash-card {{item.type}} {{item.category}} {{item.statusClass}}">
      <view class="card-top">
        <view>
          <view class="card-name">{{item.name}}</view>
          <view class="card-kind">{{item.kindText}}</view>
        </view>
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="remain-text">{{item.remainText}}</view>
      <view class="card-meta">
        <view wx:if="{{item.totalDurationText}}">总额度：{{item.totalDurationText}}</view>
        <view wx:if="{{item.totalTimesText}}">总次数：{{item.totalTimesText}}</view>
        <view wx:if="{{item.validFromText !== '--'}}">有效期：{{item.validFromText}} 至 {{item.validToText}}</view>
        <view wx:else>有效期至：{{item.validToText}}</view>
        <view>{{item.type === 'coupon' ? '来源' : '订单号'}}：{{item.productOrderNo}}</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-icon">卡</view>
    <view class="empty-title">暂无记录</view>
    <view wx:if="{{activeTab === 'member'}}" class="empty-desc">购买包月会员后，会显示在这里</view>
    <view wx:elif="{{activeTab === 'washCard'}}" class="empty-desc">购买洗车卡后，会显示在这里</view>
    <view wx:else class="empty-desc">获得洗车券后，会显示在这里</view>
  </view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
</view>
