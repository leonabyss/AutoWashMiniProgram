.benefit-icon { display: flex; align-items: center; justify-content: center; background: #edf5ff !important; flex-shrink: 0; }
.benefit-icon image { width: 40rpx; height: 40rpx; }
.detail-page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; box-sizing: border-box; background: #f6f8fc; }
.detail-card { padding: 38rpx 32rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(14,40,80,.06); }
.category { display: inline-block; padding: 8rpx 18rpx; border-radius: 8rpx; color: #216fe9; font-size: 22rpx; background: #edf5ff; }.title { margin-top: 24rpx; color: #13223a; font-size: 38rpx; font-weight: 900; }.time { margin-top: 14rpx; color: #98a2b3; font-size: 23rpx; }.divider { height: 1rpx; margin: 30rpx 0; background: #edf1f7; }.content { color: #435168; font-size: 28rpx; line-height: 1.8; }
.benefit-card { display: flex; align-items: center; margin-top: 34rpx; padding: 26rpx; border-radius: 14rpx; background: #f0f6ff; }.benefit-icon { width: 76rpx; height: 76rpx; margin-right: 22rpx; border-radius: 50%; color: #fff; font-size: 32rpx; font-weight: 800; line-height: 76rpx; text-align: center; background: #216fe9; }.benefit-label { color: #7a879c; font-size: 23rpx; }.benefit-value { margin-top: 8rpx; color: #13223a; font-size: 30rpx; font-weight: 800; }.source { margin-top: 30rpx; color: #98a2b3; font-size: 23rpx; }.action-btn { width: 100% !important; height: 84rpx !important; margin: 42rpx 0 0 !important; border-radius: 42rpx; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 84rpx; text-align: center; background: #216fe9; }
