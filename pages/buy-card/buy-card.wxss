page {
  min-height: 100%;
  background: #ffffff;
}

.buy-page,
.buy-page view,
.buy-page button,
.buy-page image,
.buy-page text {
  box-sizing: border-box;
}

.buy-page {
  width: 100%;
  min-height: 100vh;
  padding: 22rpx 24rpx calc(54rpx + env(safe-area-inset-bottom));
  color: #101828;
  background: #ffffff;
  overflow-x: hidden;
}

.buy-page button {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  line-height: normal;
  background: transparent;
}

.buy-page button::after {
  display: none;
}

.overview-bar {
  width: 100%;
  min-height: 96rpx;
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) 2rpx minmax(0, 1.08fr);
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid #e5ebf4;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(27, 65, 121, 0.07);
}

.overview-item {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.overview-icon {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
}

.overview-label {
  flex: 0 0 auto;
  color: #344054;
  font-size: 25rpx;
}

.overview-value {
  color: #0865e7;
  font-size: 31rpx;
  font-weight: 750;
  white-space: nowrap;
}

.overview-divider {
  width: 2rpx;
  height: 44rpx;
  background: #e4e9f1;
}

.site-overview {
  width: 100%;
  justify-content: flex-start;
}

.site-picker {
  width: 100%;
  min-width: 0;
  align-self: stretch;
  display: flex;
  align-items: center;
  color: inherit !important;
  text-align: left;
  background: transparent !important;
}

.site-picker:active {
  opacity: 0.72;
}

.site-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.site-caption {
  color: #0865e7;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1;
}

.site-name {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-chevron {
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 24rpx;
}

.site-selector-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.48);
  animation: site-mask-in 180ms ease both;
}

.site-selector-sheet {
  width: 100%;
  height: 78vh;
  max-height: 980rpx;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 50rpx rgba(15, 40, 78, 0.18);
  animation: site-sheet-in 220ms ease both;
}

.site-selector-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 8rpx;
  flex: 0 0 auto;
  border-radius: 8rpx;
  background: #d8dee8;
}

.site-selector-header {
  min-height: 100rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.site-selector-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.site-selector-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.2;
}

.site-selector-desc {
  color: #7b8494;
  font-size: 22rpx;
  line-height: 1.2;
}

.site-selector-close {
  width: 60rpx !important;
  height: 60rpx;
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50% !important;
  background: #f3f6fa !important;
}

.site-selector-close image {
  width: 28rpx;
  height: 28rpx;
}

.site-selector-search {
  width: 100%;
  height: 76rpx;
  margin-top: 8rpx;
  padding-left: 22rpx;
  flex: 0 0 76rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 2rpx solid #dce4ef;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.site-selector-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 72rpx;
  color: #172033;
  font-size: 27rpx;
  line-height: 72rpx;
}

.site-selector-clear {
  width: 54rpx !important;
  height: 54rpx;
  flex: 0 0 54rpx;
  color: #7b8494 !important;
  font-size: 34rpx;
  line-height: 54rpx !important;
}

.site-selector-submit {
  width: 112rpx !important;
  height: 76rpx;
  flex: 0 0 112rpx;
  color: #ffffff !important;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx !important;
  background: #1262e8 !important;
}

.site-region-row {
  width: 100%;
  margin-top: 16rpx;
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.site-region-picker,
.site-region-value {
  width: 100%;
  min-width: 0;
  height: 68rpx;
}

.site-region-value {
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  overflow: hidden;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  color: #344054;
  font-size: 25rpx;
  background: #ffffff;
}

.site-region-value text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-region-value image {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
}

.site-result-summary {
  height: 72rpx;
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #344054;
  font-size: 24rpx;
  font-weight: 700;
}

.site-result-summary text:last-child {
  color: #7b8494;
  font-size: 22rpx;
  font-weight: 500;
}

.site-selector-results {
  width: 100%;
  height: 0;
  min-height: 260rpx;
  flex: 1 1 auto;
  border-top: 2rpx solid #edf1f6;
}

.site-result-item {
  width: 100% !important;
  min-height: 132rpx;
  padding: 20rpx 6rpx !important;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 2rpx solid #edf1f6 !important;
  color: #172033 !important;
  text-align: left;
  background: #ffffff !important;
}

.site-result-item.selected {
  background: #f1f6ff !important;
}

.site-result-item:active {
  background: #eaf2ff !important;
}

.site-result-pin {
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf2ff;
}

.site-result-pin image {
  width: 34rpx;
  height: 34rpx;
}

.site-result-copy {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.site-result-name-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.site-result-name {
  min-width: 0;
  overflow: hidden;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-selected-tag {
  padding: 4rpx 10rpx;
  flex: 0 0 auto;
  border-radius: 6rpx;
  color: #1262e8;
  font-size: 19rpx;
  line-height: 1.2;
  background: #dceaff;
}

.site-result-region,
.site-result-address {
  overflow: hidden;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-result-region {
  color: #1262e8;
}

.site-result-arrow {
  flex: 0 0 auto;
  color: #98a2b3;
  font-size: 40rpx;
  font-weight: 300;
}

.site-selector-loading {
  padding: 24rpx 6rpx;
}

.site-loading-line {
  width: 58%;
  height: 24rpx;
  margin-bottom: 22rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #edf1f6 0%, #f8fafc 48%, #edf1f6 100%);
  background-size: 200% 100%;
  animation: site-loading 1.2s linear infinite;
}

.site-loading-line.wide {
  width: 86%;
}

.site-selector-empty {
  min-height: 300rpx;
  padding: 54rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.site-selector-empty-title {
  color: #344054;
  font-size: 27rpx;
  font-weight: 700;
}

.site-selector-empty-desc {
  margin-top: 12rpx;
  color: #8a94a4;
  font-size: 22rpx;
}

.site-selector-retry {
  width: 180rpx !important;
  height: 64rpx;
  margin-top: 26rpx !important;
  border: 2rpx solid #b9d1f8 !important;
  border-radius: 32rpx !important;
  color: #1262e8 !important;
  font-size: 24rpx;
  line-height: 60rpx !important;
  background: #f2f7ff !important;
}

@keyframes site-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes site-sheet-in {
  from { transform: translateY(44rpx); }
  to { transform: translateY(0); }
}

@keyframes site-loading {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

.category-tabs {
  position: relative;
  width: 100%;
  height: 92rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-bottom: 2rpx solid #edf0f5;
}

.category-tab {
  position: relative;
  z-index: 2;
  width: 100% !important;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #344054 !important;
  font-size: 30rpx;
  font-weight: 550;
  background: transparent !important;
  transition: color 220ms ease, transform 220ms ease;
}

.category-tab.active {
  color: #0865e7 !important;
  font-weight: 750;
  transform: translateY(-2rpx);
}

.tab-slider {
  position: absolute;
  left: 0;
  bottom: -2rpx;
  z-index: 3;
  width: 50%;
  height: 7rpx;
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-slider::after {
  content: '';
  display: block;
  width: 78rpx;
  height: 7rpx;
  margin: 0 auto;
  border-radius: 7rpx 7rpx 0 0;
  background: #0865e7;
}

.category-info {
  padding: 22rpx 4rpx 18rpx;
}

.category-title-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.category-title {
  color: #101828;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.1;
}

.category-desc {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
  white-space: normal;
  word-break: break-all;
}

.category-rules {
  flex: 0 0 auto;
  width: 112rpx !important;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dfe6f0 !important;
  border-radius: 21rpx !important;
  color: #7b8493 !important;
  font-size: 19rpx;
  background: #f8fafc !important;
}

.category-stage {
  width: 100%;
  overflow: hidden;
  touch-action: pan-y;
}

.category-drag-layer {
  width: 100%;
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.category-drag-layer.is-dragging {
  transition: none;
}

.category-panel {
  width: 100%;
  transform-origin: center top;
}

.category-panel:not(.is-leaving).direction-next {
  animation: panel-enter-next 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.category-panel:not(.is-leaving).direction-prev {
  animation: panel-enter-prev 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.category-panel.is-leaving.direction-next {
  animation: panel-leave-next 150ms ease both;
}

.category-panel.is-leaving.direction-prev {
  animation: panel-leave-prev 150ms ease both;
}

@keyframes panel-enter-next {
  from { opacity: 0; transform: translateX(44rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes panel-enter-prev {
  from { opacity: 0; transform: translateX(-44rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes panel-leave-next {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(-30rpx); }
}

@keyframes panel-leave-prev {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(30rpx); }
}

.product-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.product-card {
  position: relative;
  width: 100% !important;
  height: 210rpx;
  overflow: hidden;
  border: 2rpx solid rgba(204, 214, 230, 0.72) !important;
  border-radius: 16rpx !important;
  text-align: left;
  background: #f4f6f9 !important;
  box-shadow: 0 5rpx 14rpx rgba(26, 58, 105, 0.05);
  transform: translateZ(0);
  transition: transform 140ms ease, opacity 140ms ease;
}

.product-card:active {
  transform: scale(0.986);
}

.product-card.is-paying {
  opacity: 0.72;
}

.product-art-wrap {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 69%;
  overflow: hidden;
  border-radius: 0 14rpx 14rpx 0;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.22) 12%, #000000 34%, #000000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.22) 12%, #000000 34%, #000000 100%);
}

.product-art-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 116rpx;
  pointer-events: none;
}

.theme-member .product-art-wrap::after {
  background: linear-gradient(90deg, #fffdf8 0%, rgba(255, 253, 248, 0) 100%);
}

.theme-wash-card .product-art-wrap::after {
  background: linear-gradient(90deg, #ebfeff 0%, rgba(235, 254, 255, 0) 100%);
}

.theme-single .product-art-wrap::after {
  background: linear-gradient(90deg, #231061 0%, rgba(35, 16, 97, 0) 100%);
}

.product-art {
  display: block;
  width: 100%;
  height: 100%;
}

.product-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  pointer-events: none;
}

.theme-member .product-shade {
  background: linear-gradient(90deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 251, 242, 0.9) 37%, rgba(255, 247, 225, 0.08) 68%);
}

.theme-wash-card .product-shade {
  background: linear-gradient(90deg, rgba(235, 254, 255, 0.98) 0%, rgba(226, 251, 255, 0.88) 38%, rgba(192, 244, 251, 0.06) 70%);
}

.theme-single .product-shade {
  background: linear-gradient(90deg, rgba(35, 16, 97, 0.96) 0%, rgba(43, 21, 118, 0.82) 41%, rgba(42, 17, 112, 0.04) 72%);
}

.product-content {
  position: relative;
  z-index: 2;
  width: 52%;
  height: 100%;
  padding: 20rpx 0 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.product-name {
  max-width: 100%;
  overflow: hidden;
  color: #101828;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.05;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price-line {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #c98515;
}

.price-symbol {
  font-size: 25rpx;
  font-weight: 750;
}

.product-price {
  font-size: 48rpx;
  font-weight: 850;
  line-height: 1;
}

.product-rights {
  max-width: 100%;
  margin-top: 7rpx;
  overflow: hidden;
  color: #596579;
  font-size: 21rpx;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.purchase-button {
  min-width: 132rpx;
  height: 46rpx;
  margin-top: auto;
  padding: 0 20rpx;
  border-radius: 23rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 46rpx;
  text-align: center;
  background: #0865e7;
}

.theme-wash-card .product-price-line {
  color: #007d9c;
}

.theme-single .product-name,
.theme-single .product-price-line,
.theme-single .product-rights {
  color: #ffffff;
}

.theme-single .purchase-button {
  color: #43209f;
  background: #ffffff;
}

.cms-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 4;
  max-width: 230rpx;
  overflow: hidden;
  border-radius: 0 14rpx 0 16rpx;
}

.text-badge {
  min-height: 42rpx;
  padding: 0 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #f04438;
}

.image-badge {
  height: 46rpx;
}

.image-badge image {
  display: block;
  width: auto;
  height: 46rpx;
}

.empty-products {
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #98a2b3;
  font-size: 25rpx;
}

.preview-section {
  margin-top: 30rpx;
}

.preview-title-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 650;
}

.preview-line {
  height: 2rpx;
  background: #e8ecf2;
}

.preview-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
}

.preview-card {
  position: relative;
  width: 100% !important;
  height: 130rpx;
  overflow: hidden;
  border: 2rpx solid #dde5ef !important;
  border-radius: 14rpx !important;
  text-align: left;
  background: #f4f6f9 !important;
  transition: transform 150ms ease, box-shadow 150ms ease;
}

.preview-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(16, 84, 187, 0.14);
}

.preview-art,
.preview-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.preview-shade {
  z-index: 1;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.76) 48%, rgba(255, 255, 255, 0.03) 82%);
}

.preview-single .preview-shade {
  background: linear-gradient(90deg, rgba(248, 245, 255, 0.98) 0%, rgba(245, 240, 255, 0.78) 48%, rgba(74, 29, 167, 0.04) 82%);
}

.preview-copy {
  position: relative;
  z-index: 2;
  width: 64%;
  height: 100%;
  padding: 18rpx 0 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.preview-label {
  color: #0865e7;
  font-size: 25rpx;
  font-weight: 750;
}

.preview-subtitle {
  margin-top: 6rpx;
  color: #667085;
  font-size: 18rpx;
  white-space: nowrap;
}

.preview-price {
  margin-top: auto;
  color: #101828;
  font-size: 20rpx;
  font-weight: 700;
}

.rules-toggle {
  width: 230rpx !important;
  height: 78rpx;
  margin: 20rpx auto 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #475467 !important;
  font-size: 24rpx;
}

.rules-arrow {
  width: 28rpx;
  height: 28rpx;
}

.rules-panel {
  margin-top: 4rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #f6f8fb;
  animation: rules-open 220ms ease both;
}

@keyframes rules-open {
  from { opacity: 0; transform: translateY(-12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.rule-item {
  margin-top: 18rpx;
  color: #475467;
  font-size: 22rpx;
  line-height: 1.55;
}

.rule-item:first-child {
  margin-top: 0;
}

@media (prefers-reduced-motion: reduce) {
  .category-panel,
  .rules-panel,
  .site-selector-mask,
  .site-selector-sheet,
  .site-loading-line {
    animation: none !important;
  }

  .tab-slider,
