@import "../../components/fault-report-panel/fault-report-panel.wxss";

page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
}

.finish-page {
  display: flex;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  color: #172640;
  background: #ffffff;
}

.progress-strip {
  position: relative;
  display: flex;
  width: 100%;
  height: 112rpx;
  padding: 18rpx 26rpx 12rpx;
  flex: 0 0 112rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.progress-line {
  position: absolute;
  left: 90rpx;
  right: 90rpx;
  top: 42rpx;
  height: 3rpx;
  background: #1262e8;
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  width: 150rpx;
  align-items: center;
  flex-direction: column;
  color: #1262e8;
}

.progress-dot {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #1262e8;
  border-radius: 50%;
  background: #1262e8;
}

.progress-dot image {
  width: 30rpx;
  height: 30rpx;
}

.progress-step text {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.final-step {
  color: #079447;
}

.final-step .progress-dot {
  border-color: #08a94f;
  background: #08a94f;
}

.finish-hero {
  display: flex;
  padding: 32rpx 40rpx 25rpx;
  flex: 0 0 auto;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.success-mark {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #08a94f;
  box-shadow: 0 14rpx 32rpx rgba(8, 169, 79, 0.18);
}

.success-mark.loading {
  background: #1262e8;
  box-shadow: 0 14rpx 32rpx rgba(18, 98, 232, 0.18);
}

.success-mark image {
  width: 65rpx;
  height: 65rpx;
}

.loading-ring {
  width: 54rpx;
  height: 54rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: finish-rotate 0.85s linear infinite;
}

@keyframes finish-rotate {
  to { transform: rotate(360deg); }
}

.finish-title {
  margin-top: 22rpx;
  color: #15243c;
  font-size: 45rpx;
  font-weight: 800;
  line-height: 1.15;
}

.finish-subtitle {
  margin-top: 10rpx;
  color: #7a879a;
  font-size: 25rpx;
  line-height: 1.4;
}

.settlement-summary {
  display: grid;
  height: 154rpx;
  margin: 0 40rpx;
  padding: 20rpx 0;
  flex: 0 0 154rpx;
  grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 1fr);
  align-items: center;
  border-radius: 18rpx;
  background: #f2f7ff;
}

.summary-item {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.summary-label {
  color: #66758c;
  font-size: 24rpx;
  line-height: 1;
}

.summary-value,
.amount-value {
  margin-top: 16rpx;
  color: #1262e8;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.amount-value text {
  margin-right: 4rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.amount-value .summary-unit {
  margin-right: 0;
  margin-left: 5rpx;
  font-size: 25rpx;
}

.summary-divider {
  width: 1rpx;
  height: 76rpx;
  background: #d4e1f5;
}

.summary-skeleton {
  width: 130rpx;
  height: 34rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #dae5f5 25%, #edf3fc 50%, #dae5f5 75%);
  background-size: 200% 100%;
  animation: finish-shimmer 1.25s ease-in-out infinite;
}

@keyframes finish-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

.order-detail {
  margin: 20rpx 40rpx 0;
  flex: 0 0 auto;
  border-top: 1rpx solid #e7ebf2;
}

.detail-row {
  display: grid;
  height: 70rpx;
  grid-template-columns: 38rpx 142rpx minmax(0, 1fr);
  align-items: center;
  border-bottom: 1rpx solid #edf0f5;
}

.detail-row image {
  width: 32rpx;
  height: 32rpx;
}

.detail-label {
  color: #68758a;
  font-size: 25rpx;
}

.detail-value,
.balance-value {
  min-width: 0;
  overflow: hidden;
  color: #24334c;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-value {
  color: #f26b1d;
  font-size: 30rpx;
  font-weight: 800;
}

.balance-value text {
  margin-right: 3rpx;
  font-size: 22rpx;
}

.balance-value .remaining-unit {
  margin-right: 0;
  margin-left: 5rpx;
}

.amount-value.green,
.balance-value.green {
  color: #079447;
}

.amount-value.blue,
.balance-value.blue {
  color: #1262e8;
}

.fault-entry {
  display: flex;
  width: auto !important;
  height: 74rpx !important;
  margin: 18rpx 40rpx 0 !important;
  padding: 0 !important;
  flex: 0 0 74rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffd8be;
  border-radius: 14rpx;
  color: #eb681b;
  font-size: 26rpx;
  font-weight: 650;
  background: #fff8f2;
}

.fault-entry image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.fault-entry-hover {
  background: #ffefe3;
}

.finish-bottom {
  margin-top: auto;
  padding: 20rpx 40rpx calc(24rpx + var(--safe-bottom));
  flex: 0 0 auto;
}

.home-btn {
  display: flex;
  width: 100% !important;
  height: 112rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 750;
  background: #1262e8;
  box-shadow: 0 14rpx 28rpx rgba(18, 98, 232, 0.2);
}

.home-btn image {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
}

.home-btn-hover {
  background: #0e53c7;
}



.finish-compact .progress-strip {
  height: 96rpx;
  padding-top: 9rpx;
  flex-basis: 96rpx;
}

.finish-compact .progress-line { top: 33rpx; }
.finish-compact .progress-dot { width: 44rpx; height: 44rpx; }
.finish-compact .progress-step text { margin-top: 7rpx; font-size: 21rpx; }
.finish-compact .finish-hero { padding-top: 18rpx; padding-bottom: 18rpx; }
.finish-compact .success-mark { width: 92rpx; height: 92rpx; }
.finish-compact .success-mark image { width: 54rpx; height: 54rpx; }
.finish-compact .finish-title { margin-top: 14rpx; font-size: 39rpx; }
.finish-compact .finish-subtitle { margin-top: 6rpx; font-size: 23rpx; }
.finish-compact .settlement-summary { height: 132rpx; flex-basis: 132rpx; }
.finish-compact .summary-value,
.finish-compact .amount-value { margin-top: 12rpx; font-size: 37rpx; }
.finish-compact .order-detail { margin-top: 14rpx; }
.finish-compact .detail-row { height: 60rpx; }
.finish-compact .fault-entry { height: 66rpx !important; margin-top: 13rpx !important; flex-basis: 66rpx; }
.finish-compact .finish-bottom { padding-top: 14rpx; padding-bottom: calc(16rpx + var(--safe-bottom)); }
.finish-compact .home-btn { height: 96rpx !important; font-size: 34rpx; }

.finish-tight .progress-strip {
  height: 82rpx;
  padding: 5rpx 12rpx 3rpx;
  flex-basis: 82rpx;
}

.finish-tight .progress-line { left: 72rpx; right: 72rpx; top: 26rpx; }
.finish-tight .progress-step { width: 134rpx; }
.finish-tight .progress-dot { width: 40rpx; height: 40rpx; border-width: 4rpx; }
.finish-tight .progress-dot image { width: 25rpx; height: 25rpx; }
.finish-tight .progress-step text { margin-top: 4rpx; font-size: 19rpx; }
.finish-tight .finish-hero { padding: 11rpx 28rpx 10rpx; }
.finish-tight .success-mark { width: 72rpx; height: 72rpx; }
.finish-tight .success-mark image { width: 42rpx; height: 42rpx; }
.finish-tight .loading-ring { width: 36rpx; height: 36rpx; border-width: 4rpx; }
.finish-tight .finish-title { margin-top: 8rpx; font-size: 34rpx; }
.finish-tight .finish-subtitle { margin-top: 4rpx; font-size: 20rpx; }

.finish-tight .settlement-summary {
  height: 108rpx;
  margin-right: 28rpx;
  margin-left: 28rpx;
  padding: 12rpx 0;
  flex-basis: 108rpx;
}

.finish-tight .summary-label { font-size: 21rpx; }
.finish-tight .summary-value,
.finish-tight .amount-value { margin-top: 9rpx; font-size: 32rpx; }
.finish-tight .order-detail { margin: 9rpx 28rpx 0; }

.finish-tight .detail-row {
  height: 49rpx;
  grid-template-columns: 32rpx 116rpx minmax(0, 1fr);
}

.finish-tight .detail-row image { width: 27rpx; height: 27rpx; }
.finish-tight .detail-label,
.finish-tight .detail-value { font-size: 21rpx; }
.finish-tight .balance-value { font-size: 25rpx; }

.finish-tight .fault-entry {
  height: 56rpx !important;
  margin: 9rpx 28rpx 0 !important;
  flex-basis: 56rpx;
  font-size: 21rpx;
}

.finish-tight .fault-entry image { width: 27rpx; height: 27rpx; margin-right: 8rpx; }
.finish-tight .finish-bottom { padding: 10rpx 28rpx calc(10rpx + var(--safe-bottom)); }
.finish-tight .home-btn { height: 82rpx !important; font-size: 30rpx; }
.finish-tight .home-btn image { width: 34rpx; height: 34rpx; margin-right: 13rpx; }

@media screen and (max-width: 350px) {
  .settlement-summary,
  .order-detail,
  .fault-entry { margin-right: 24rpx !important; margin-left: 24rpx !important; }
  .finish-bottom { padding-right: 24rpx; padding-left: 24rpx; }
}
