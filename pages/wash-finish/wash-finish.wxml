<view class="finish-page {{finishSizeClass}} {{reviewMode ? 'review-flow-mode' : ''}}" style="{{finishViewportStyle}}">
  <include src="../../components/review-notice/review-notice.wxml" />
  <view class="progress-strip">
    <view class="progress-line"></view>
    <view class="progress-step completed">
      <view class="progress-dot"><image src="/assets/icons/lucide-check-white.svg" mode="aspectFit"></image></view>
      <text>设备识别</text>
    </view>
    <view class="progress-step completed">
      <view class="progress-dot"><image src="/assets/icons/lucide-check-white.svg" mode="aspectFit"></image></view>
      <text>结算确认</text>
    </view>
    <view class="progress-step completed">
      <view class="progress-dot"><image src="/assets/icons/lucide-check-white.svg" mode="aspectFit"></image></view>
      <text>设备启动</text>
    </view>
    <view class="progress-step completed final-step">
      <view class="progress-dot"><image src="/assets/icons/lucide-check-white.svg" mode="aspectFit"></image></view>
      <text>洗车完成</text>
    </view>
  </view>

  <view class="finish-hero">
    <view class="success-mark {{settlementLoading ? 'loading' : ''}}">
      <image wx:if="{{!settlementLoading}}" src="/assets/icons/lucide-check-white.svg" mode="aspectFit"></image>
      <view wx:else class="loading-ring"></view>
    </view>
    <view class="finish-title">{{settlementLoading ? '正在结算' : '洗车完成'}}</view>
    <view class="finish-subtitle">{{settlementLoading ? '正在同步本次洗车数据' : '本次服务已结束，感谢您的使用'}}</view>
  </view>

  <view class="settlement-summary">
    <view class="summary-item">
      <text class="summary-label">本次用时</text>
      <view wx:if="{{settlementLoading}}" class="summary-skeleton"></view>
      <text wx:else class="summary-value">{{displayTime}}</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">{{settlementSummary.label}}</text>
      <view wx:if="{{settlementLoading}}" class="summary-skeleton"></view>
      <view wx:else class="amount-value {{settlementSummary.tone}}">
        <text wx:if="{{settlementSummary.prefix}}">{{settlementSummary.prefix}}</text>{{settlementSummary.value}}<text wx:if="{{settlementSummary.unit}}" class="summary-unit">{{settlementSummary.unit}}</text>
      </view>
    </view>
  </view>

  <view class="order-detail">
    <view class="detail-row">
      <image src="/assets/icons/lucide-map-pin-blue.svg" mode="aspectFit"></image>
      <text class="detail-label">洗车点</text>
      <text class="detail-value">{{siteName}}</text>
    </view>
    <view class="detail-row">
      <image src="/assets/icons/lucide-qr-code.svg" mode="aspectFit"></image>
      <text class="detail-label">洗车设备</text>
      <text class="detail-value">{{machineName}}</text>
    </view>
    <view class="detail-row">
      <image src="/assets/icons/lucide-credit-card.svg" mode="aspectFit"></image>
      <text class="detail-label">结算方式</text>
      <text class="detail-value">{{payMethodText}}</text>
    </view>
    <view class="detail-row balance-row">
      <image src="{{remainingSummary.icon}}" mode="aspectFit"></image>
      <text class="detail-label">{{remainingSummary.label}}</text>
      <view class="balance-value {{remainingSummary.tone}}">
        <text wx:if="{{remainingSummary.prefix}}">{{remainingSummary.prefix}}</text>{{remainingSummary.value}}<text wx:if="{{remainingSummary.unit}}" class="remaining-unit">{{remainingSummary.unit}}</text>
      </view>
    </view>
  </view>

  <button class="fault-entry" hover-class="fault-entry-hover" bindtap="reportFault">
    <image src="/assets/icons/lucide-wrenches-orange.svg" mode="aspectFit"></image>
    <text>{{faultReported ? '故障已上报' : '本次洗车遇到问题？故障上报'}}</text>
  </button>

  <view class="finish-bottom">
    <button class="home-btn" hover-class="home-btn-hover" bindtap="backHome">
      <image src="/assets/icons/lucide-home-white.svg" mode="aspectFit"></image>
      <text>返回首页</text>
    </button>
  </view>

<include src="../../components/fault-report-panel/fault-report-panel.wxml" />
</view>
