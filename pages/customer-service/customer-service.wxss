page { background: #f6f8fc; }
.support-page { width: 100%; min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); color: #172033; }
.support-intro { padding: 64rpx 32rpx 48rpx; text-align: center; background: #fff; border-bottom: 1rpx solid #e9eef6; }
.support-symbol { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #eaf2ff; }
.support-symbol image { width: 58rpx; height: 58rpx; }
.support-title { font-size: 40rpx; font-weight: 600; line-height: 1.4; }
.support-subtitle { margin-top: 16rpx; font-size: 26rpx; color: #627086; line-height: 1.7; }
.support-content { padding: 36rpx 32rpx; }
.section-title { margin-bottom: 20rpx; font-size: 28rpx; font-weight: 600; }
.support-destination { display: flex; align-items: center; gap: 22rpx; min-height: 144rpx; padding: 28rpx; border: 1rpx solid #e1e8f3; border-radius: 16rpx; background: #fff; }
.destination-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; height: 72rpx; border-radius: 12rpx; background: #edf4ff; }
.destination-icon image { width: 38rpx; height: 38rpx; }
.destination-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 10rpx; }
.destination-label { font-size: 24rpx; color: #627086; line-height: 1.5; }
.destination-name { font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.support-hint { margin-top: 18rpx; font-size: 24rpx; line-height: 1.6; color: #627086; }
.support-phone { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding: 24rpx 28rpx; border: 1rpx solid #e1e8f3; border-radius: 16rpx; background: #fff; }
.support-phone-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; overflow-wrap: anywhere; }
.support-phone-number { color: #172033; font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.support-page .support-call-button { flex: 0 0 auto; margin: 0; padding: 16rpx; border-radius: 8rpx; color: #125bcf; background: #edf4ff; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.support-page .support-call-pressed { background: #dce9fc; }
.support-page .contact-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 100rpx; margin: 48rpx 0 0; padding: 22rpx 24rpx; border-radius: 14rpx; color: #fff; background: #1262e8; font-size: 32rpx; font-weight: 600; line-height: 1.5; box-shadow: 0 10rpx 24rpx rgba(18,98,232,.16); }
.support-page .contact-button[disabled] { background: #dce7fa; color: #657c9f; box-shadow: none; }
.support-page .contact-pressed { background: #0e53cb; }
.support-note { margin-top: 24rpx; color: #7c8799; font-size: 23rpx; line-height: 1.7; text-align: center; }
.support-error { display: flex; flex-direction: column; align-items: flex-start; gap: 16rpx; margin-top: 24rpx; padding: 24rpx; background: #edf3ff; border-radius: 12rpx; color: #425c83; font-size: 26rpx; line-height: 1.6; }
.support-page .retry-button { margin: 0; padding: 10rpx 20rpx; border: 1rpx solid #1262e8; border-radius: 8rpx; color: #1262e8; font-size: 24rpx; line-height: 1.5; }
.skeleton { border-radius: 6rpx; background: #edf1f7; animation: support-pulse 1.3s ease-in-out infinite alternate; }
.skeleton-label { width: 150rpx; height: 24rpx; }
.skeleton-name { width: 75%; height: 34rpx; }
@keyframes support-pulse { from { opacity: .5; } to { opacity: 1; } }
@media (max-width: 340px) { .support-content { padding: 28rpx 24rpx; } .support-intro { padding: 44rpx 24rpx 36rpx; } }
