.mine-page {
  position: relative;
  isolation: isolate;
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  overflow-x: hidden;
  background: #f7f9ff;
}

.blue-shape {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 0;
  height: 420rpx;
  overflow: hidden;
  pointer-events: none;
  background: #216fe9;
  border-radius: 0 0 50% 50% / 0 0 11% 11%;
  transform-origin: top center;
  transition: height 360ms cubic-bezier(0.2, 0.8, 0.2, 1), border-radius 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.profile-band {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 42rpx 36rpx 76rpx;
  color: #fff;
  transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  color: #216fe9;
  font-size: 48rpx;
  font-weight: 800;
  text-align: center;
  line-height: 118rpx;
  background: #fff;
}

.avatar-image {
  display: block;
  background: #fff;
}

.profile-name {
  font-size: 42rpx;
  font-weight: 800;
}

.profile-phone {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.mine-card {
  position: relative;
  z-index: 2;
  margin: -42rpx 24rpx 24rpx;
  padding: 30rpx 12rpx;
  transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.stat-item {
  position: relative;
  text-align: center;
  border-right: 1rpx solid #eef1f7;
}

.stat-item-hover { opacity: 0.65; }

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: #13223a;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 10rpx;
  color: #7a879c;
  font-size: 24rpx;
}

.stat-detail { margin-top: 8rpx; color: #216fe9; font-size: 20rpx; }

.menu-card {
  position: relative;
  z-index: 2;
  margin: 0 24rpx 40rpx;
  padding: 8rpx 28rpx;
}

.preview-card {
  position: relative;
  z-index: 2;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #13223a;
  font-size: 31rpx;
  font-weight: 900;
}

.section-link {
  color: #216fe9;
  font-size: 25rpx;
  font-weight: 700;
}

.active-card-list {
  margin-top: 20rpx;
}

.active-card-item {
  min-height: 112rpx;
  padding: 22rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef6ff 0%, #f7fbff 100%);
}

.active-card-name {
  color: #13223a;
  font-size: 30rpx;
  font-weight: 900;
}

.active-card-expire {
  margin-top: 10rpx;
  color: #7a879c;
  font-size: 23rpx;
}

.active-card-value {
  flex: 0 0 auto;
  color: #216fe9;
  font-size: 27rpx;
  font-weight: 900;
}

.weui-cell.menu-row {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1f8;
  color: #1d2b43;
  font-size: 30rpx;
}

.weui-cell.menu-row:last-child {
  border-bottom: 0;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.menu-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  background: #f04438;
}

.arrow {
  color: #a4adbc;
  font-size: 44rpx;
}

.logout-section {
  position: relative;
  z-index: 2;
  margin: 44rpx 24rpx 56rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e7ecf5;
}

.logout-btn {
  width: 100% !important;
  height: 92rpx !important;
  margin: 0 !important;
  border-radius: 16rpx;
  color: #d92d20;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 92rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(14, 40, 80, 0.06);
}

.logout-btn::after {
  border: 0;
}

.mine-skeleton { position: relative; z-index: 2; padding-top: 42rpx; }
.skeleton-profile { display: flex; align-items: center; padding: 0 36rpx 76rpx; }
.skeleton { overflow: hidden; background: rgba(255, 255, 255, 0.28); animation: skeleton-pulse 1.25s ease-in-out infinite; }
.skeleton-avatar { width: 118rpx; height: 118rpx; flex: 0 0 auto; border-radius: 50%; }
.skeleton-profile-lines { flex: 1; margin-left: 24rpx; }
.skeleton-line { height: 28rpx; border-radius: 8rpx; }
.skeleton-name { width: 42%; height: 38rpx; }
.skeleton-phone { width: 66%; margin-top: 18rpx; }
.skeleton-card { margin: -42rpx 24rpx 24rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(14, 40, 80, 0.07); }
.skeleton-stats { display: grid; grid-template-columns: repeat(3, 1fr); padding: 34rpx 12rpx; }
.skeleton-stat { display: flex; flex-direction: column; align-items: center; }
.skeleton-value { width: 76rpx; height: 34rpx; border-radius: 8rpx; background: #e9edf5; }
.skeleton-label { width: 58rpx; height: 22rpx; margin-top: 14rpx; border-radius: 7rpx; background: #eef1f6; }
.skeleton-menu { margin-top: 24rpx; padding: 8rpx 28rpx; }
.skeleton-menu-row { height: 104rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf1f8; }
.skeleton-menu-row:last-child { border-bottom: 0; }
.skeleton-menu-text { width: 180rpx; height: 28rpx; border-radius: 8rpx; background: #e9edf5; }
.skeleton-arrow { width: 18rpx; height: 28rpx; border-radius: 6rpx; background: #edf0f5; }
.mine-empty { position: relative; z-index: 2; padding: 250rpx 48rpx 0; text-align: center; }
.mine-empty-title { color: #fff; font-size: 34rpx; font-weight: 800; }
.mine-empty-desc { margin-top: 18rpx; color: rgba(255,255,255,.78); font-size: 26rpx; }
.retry-btn { width: 220rpx !important; height: 76rpx !important; margin: 42rpx auto 0 !important; border-radius: 38rpx; color: #216fe9; font-size: 28rpx; line-height: 76rpx; text-align: center; background: #fff; }
@keyframes skeleton-pulse { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
