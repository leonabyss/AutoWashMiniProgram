.wash-network-notice {
  flex: 0 0 auto;
  width: 100%;
  padding: 12rpx 20rpx;
  color: #8a4308;
  background: #fff3dc;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
}

page {
  width: 100vw;
  min-height: 100%;
  color: #13223a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  background: #216fe9;
  overflow-x: hidden;
}

view,
text,
button,
input,
swiper,
swiper-item {
  box-sizing: border-box;
}

button {
  position: relative;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: none;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: normal;
  /* text-align: inherit; */
  background: transparent;
  box-shadow: none;
  outline: none;
  -webkit-appearance: none;
  appearance: none;
}

button::after {
  display: none;
  border: none;
}

button[disabled] {
  color: inherit;
  background: transparent;
  opacity: 1;
}

.button-hover {
  color: inherit;
  background: transparent;
}

button.weui-btn {
  margin: 0;
  padding: 0;
  line-height: normal;
}

button.weui-btn::after {
  display: none;
  border: none;
}

.app-page {
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  overflow-x: hidden;
  background: linear-gradient(180deg, #216fe9 0%, #216fe9 46%, #f7f9ff 46%, #f7f9ff 100%);
}

.deep-page {
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  overflow-x: hidden;
  color: #fff;
  background: linear-gradient(180deg, #314a75 0%, #263b65 100%);
}

.primary-btn {
  width: 100% !important;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #fff;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 0;
  background: linear-gradient(180deg, #3b94ff 0%, #126de6 100%);
  box-shadow: 0 18rpx 28rpx rgba(31, 111, 232, 0.26);
}

.orange-btn {
  background: linear-gradient(180deg, #ff7636 0%, #f05a1d 100%);
  box-shadow: 0 20rpx 32rpx rgba(239, 92, 29, 0.26);
}

.yellow-btn {
  background: linear-gradient(180deg, #fff900 0%, #fff000 100%);
  color: #111;
  box-shadow: none;
}

.white-card {
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 24rpx 60rpx rgba(29, 65, 137, 0.12);
}

.muted {
  color: #71809a;
}

.price {
  color: #ffd600;
  font-weight: 700;
}
.review-flow-notice {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 80;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  text-align: center;
  color: #774b12;
  background: #fff0ce;
  pointer-events: none;
}
.review-flow-mode { padding-top: 48rpx !important; box-sizing: border-box; }
.review-account-note { margin: 18rpx 24rpx; color: #52677e; font-size: 24rpx; line-height: 1.6; }
